# Optional Docker Compose overrides. Copy this file to .env before editing.
COMPOSE_PROJECT_NAME=isaac-sim-renderer
ISAAC_SIM_VERSION=6.0.1
ISAAC_SIM_IMAGE=isaac-sim-renderer:6.0.1

# Keep all GPUs and all driver features visible to Isaac Sim (RTX, Vulkan,
# CUDA, video encode, and video decode).
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# Relative paths are resolved from the repository root. The directory must
# exist before Compose starts; scripts/prepare.sh creates the default.
ISAAC_OUTPUT_DIR_HOST=./outputs

# ACCEPT_EULA=Y is deliberately fixed in docker-compose.yaml. Starting the
# service therefore indicates acceptance of the NVIDIA Isaac Sim EULA.

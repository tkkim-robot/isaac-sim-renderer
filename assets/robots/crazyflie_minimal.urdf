<?xml version="1.0"?>
<!--
  A deliberately small, mesh-free Crazyflie stand-in for Isaac Sim tutorials.
  Coordinates follow REP-103: +x forward, +y left, +z up; all values are SI.
-->
<robot name="crazyflie_minimal">
  <material name="cf_black">
    <color rgba="0.035 0.040 0.045 1.0"/>
  </material>
  <material name="cf_dark_gray">
    <color rgba="0.18 0.20 0.22 1.0"/>
  </material>
  <material name="cf_circuit_green">
    <color rgba="0.08 0.32 0.16 1.0"/>
  </material>
  <material name="cf_front_red">
    <color rgba="0.95 0.08 0.05 1.0"/>
  </material>
  <material name="cf_rear_blue">
    <color rgba="0.05 0.28 0.95 1.0"/>
  </material>
  <material name="cf_propeller">
    <color rgba="0.12 0.12 0.12 0.82"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <mass value="0.028"/>
      <inertia ixx="0.000025" ixy="0" ixz="0"
               iyy="0.000025" iyz="0" izz="0.000045"/>
    </inertial>

    <!-- Main circuit board. -->
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.050 0.004"/>
      </geometry>
      <material name="cf_circuit_green"/>
    </visual>
    <!-- Battery underneath the board. -->
    <visual>
      <origin xyz="-0.004 0 0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.042 0.026 0.009"/>
      </geometry>
      <material name="cf_dark_gray"/>
    </visual>
    <!-- Diagonal carbon-fiber arms. -->
    <visual>
      <origin xyz="0.023 0.023 0.014" rpy="0 1.5707963 0.7853982"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
      <material name="cf_black"/>
    </visual>
    <visual>
      <origin xyz="0.023 -0.023 0.014" rpy="0 1.5707963 -0.7853982"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
      <material name="cf_black"/>
    </visual>
    <visual>
      <origin xyz="-0.023 0.023 0.014" rpy="0 1.5707963 2.3561945"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
      <material name="cf_black"/>
    </visual>
    <visual>
      <origin xyz="-0.023 -0.023 0.014" rpy="0 1.5707963 -2.3561945"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
      <material name="cf_black"/>
    </visual>
    <!-- A red nose and blue tail make heading obvious in rendered frames. -->
    <visual>
      <origin xyz="0.026 0 0.017" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.018 0.006"/>
      </geometry>
      <material name="cf_front_red"/>
    </visual>
    <visual>
      <origin xyz="-0.026 0 0.017" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.018 0.006"/>
      </geometry>
      <material name="cf_rear_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.050 0.004"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.004 0 0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.042 0.026 0.009"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.023 0.023 0.014" rpy="0 1.5707963 0.7853982"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.023 -0.023 0.014" rpy="0 1.5707963 -0.7853982"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.023 0.023 0.014" rpy="0 1.5707963 2.3561945"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.023 -0.023 0.014" rpy="0 1.5707963 -2.3561945"/>
      <geometry>
        <cylinder radius="0.0025" length="0.065"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_rotor">
    <inertial>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000000040" ixy="0" ixz="0"
               iyy="0.000000040" iyz="0" izz="0.000000020"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
      <material name="cf_front_red"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.006 0.001"/>
      </geometry>
      <material name="cf_propeller"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_left_rotor_joint" type="continuous">
    <origin xyz="0.046 0.046 0.017" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_rotor"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.01" velocity="3000"/>
    <dynamics damping="0.000001" friction="0"/>
  </joint>

  <link name="front_right_rotor">
    <inertial>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000000040" ixy="0" ixz="0"
               iyy="0.000000040" iyz="0" izz="0.000000020"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
      <material name="cf_front_red"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0.7853982"/>
      <geometry>
        <box size="0.055 0.006 0.001"/>
      </geometry>
      <material name="cf_propeller"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_right_rotor_joint" type="continuous">
    <origin xyz="0.046 -0.046 0.017" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_rotor"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.01" velocity="3000"/>
    <dynamics damping="0.000001" friction="0"/>
  </joint>

  <link name="rear_left_rotor">
    <inertial>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000000040" ixy="0" ixz="0"
               iyy="0.000000040" iyz="0" izz="0.000000020"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
      <material name="cf_rear_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 -0.7853982"/>
      <geometry>
        <box size="0.055 0.006 0.001"/>
      </geometry>
      <material name="cf_propeller"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_rotor_joint" type="continuous">
    <origin xyz="-0.046 0.046 0.017" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_rotor"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.01" velocity="3000"/>
    <dynamics damping="0.000001" friction="0"/>
  </joint>

  <link name="rear_right_rotor">
    <inertial>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000000040" ixy="0" ixz="0"
               iyy="0.000000040" iyz="0" izz="0.000000020"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
      <material name="cf_rear_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.006 0.001"/>
      </geometry>
      <material name="cf_propeller"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_rotor_joint" type="continuous">
    <origin xyz="-0.046 -0.046 0.017" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_rotor"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.01" velocity="3000"/>
    <dynamics damping="0.000001" friction="0"/>
  </joint>
</robot>
